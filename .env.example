# Pyrnova configuration. Copy to .env and fill in. Never commit .env.

# --- Sources ---
# USAspending needs NO key (public). SAM.gov Opportunities API requires a key:
#   Get one at https://sam.gov (Account Details -> API Key) or https://open.gsa.gov/api/get-opportunities-public-api/
SAM_API_KEY=

# --- Evidence archive ---
# LOCAL (default, no cloud needed): raw evidence stored under PYRNOVA_ARCHIVE_DIR.
# S3/R2: set PYRNOVA_ARCHIVE_BACKEND=s3 and the S3-compatible credentials below.
PYRNOVA_ARCHIVE_BACKEND=local
PYRNOVA_ARCHIVE_DIR=./var/archive

# Cloudflare R2 / any S3-compatible object store (only if PYRNOVA_ARCHIVE_BACKEND=s3)
PYRNOVA_S3_ENDPOINT_URL=
PYRNOVA_S3_BUCKET=
PYRNOVA_S3_ACCESS_KEY_ID=
PYRNOVA_S3_SECRET_ACCESS_KEY=
PYRNOVA_S3_REGION=auto

# --- Reserved production database setting ---
# db/schema.sql documents the intended Postgres mirror, but the current runtime does not
# connect to it. Local development uses append-only JSONL under PYRNOVA_STATE_DIR.
PYRNOVA_DATABASE_URL=

# --- Runtime state (append-only history; kept off cloud in dev) ---
PYRNOVA_STATE_DIR=./var/state
PYRNOVA_OUT_DIR=./out

# --- Operator alerts + dead-man / liveness watcher ---
# Alerts always persist durably under PYRNOVA_ALERT_STATE_DIR regardless of email config; email is the
# operator-notification transport for OPERATOR_ATTENTION/CRITICAL only (INFO is logs-only, never emailed).
# With no host/sender/recipient, delivery is reported not_configured (explicit) — never silently "sent".
PYRNOVA_ALERT_ENABLED=1
PYRNOVA_ALERT_RECIPIENTS=          # comma-separated operator inbox(es), e.g. ops@yourdomain
PYRNOVA_ALERT_SENDER=             # verified From address, e.g. pyrnova-alerts@yourdomain
PYRNOVA_ALERT_MAX_ATTEMPTS=3      # bounded retries per delivery; a failure is logged, never re-alerted
PYRNOVA_ALERT_STATE_DIR=./var/alerts
# SMTP transport (credentials are secrets — prefer .env over process env; NEVER commit real values):
PYRNOVA_SMTP_HOST=
PYRNOVA_SMTP_PORT=587            # 465 = implicit SSL; otherwise STARTTLS when PYRNOVA_SMTP_USE_TLS=1
PYRNOVA_SMTP_USERNAME=
PYRNOVA_SMTP_PASSWORD=
PYRNOVA_SMTP_USE_TLS=1
# Dead-man watcher (run as a SEPARATE scheduled process: `python -m pyrnova.watchdog check`):
PYRNOVA_HEARTBEAT_DIR=./var/heartbeat
PYRNOVA_DEADMAN_COMPONENT=live_ops
PYRNOVA_DEADMAN_MAX_SILENCE_SECONDS=900   # accepted silence before a CRITICAL dead-man incident opens
