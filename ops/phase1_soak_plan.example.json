{
  "soak_id": "phase1-live-ops-SET_START_DATE",
  "soak_test_lens": "IRONMOUNTAIN SOLUTIONS, LLC",
  "designation": "SOAK TEST LENS — NON-CUSTOMER / NON-COMMERCIAL",
  "canonical_commit": "SET_VERIFIED_MAIN_COMMIT",
  "environment": "founder-mac-local-jsonl",
  "duration_calendar_days": 7,
  "required_business_days": 5,
  "evidence_dir": "evidence",
  "state_dir": "../state",
  "source_state_dir": "source_state",
  "archive_dir": "archive",
  "customers": [
    {
      "customer_id": "soak-ironmountain-solutions",
      "profile": "ironmountain_profile.json",
      "monitored_objects": 1
    }
  ],
  "sources": [
    {
      "source_id": "usaspending",
      "interval_seconds": 604800,
      "max_calls_per_epoch": 2,
      "customer_ids": ["soak-ironmountain-solutions"],
      "request": {
        "method": "POST",
        "url": "https://api.usaspending.gov/api/v2/search/spending_by_award/",
        "payload": {
          "filters": {
            "award_type_codes": ["A", "B", "C", "D"],
            "time_period": [{"start_date": "2020-01-01", "end_date": "{{today_iso}}"}],
            "recipient_search_text": ["IronMountain Solutions"]
          },
          "fields": [
            "Award ID", "Recipient Name", "Start Date", "End Date", "Award Amount",
            "Awarding Agency", "Awarding Sub Agency", "Contract Award Type", "Description",
            "NAICS Code", "PSC Code", "recipient_id", "generated_internal_id"
          ],
          "page": 1,
          "limit": 100,
          "sort": "Award Amount",
          "order": "desc"
        }
      }
    },
    {
      "source_id": "sam_opportunities",
      "interval_seconds": 86400,
      "max_calls_per_epoch": 1,
      "customer_ids": ["soak-ironmountain-solutions"],
      "request": {
        "method": "GET",
        "url": "https://api.sam.gov/opportunities/v2/search",
        "params": {
          "api_key": "${SAM_API_KEY}",
          "postedFrom": "{{date_minus_30_mmddyyyy}}",
          "postedTo": "{{today_mmddyyyy}}",
          "limit": 100,
          "offset": 0
        }
      }
    }
  ],
  "health_thresholds": {
    "unresolved_p0": 0,
    "future_data_leakage": 0,
    "tenant_leakage": 0,
    "unexplained_evidence_loss": 0,
    "uncontrolled_duplicates": 0,
    "silent_source_failure": 0
  },
  "failure_thresholds": {
    "consecutive_failed_cycles": 3,
    "founder_invalidating_interventions": 0
  },
  "allowed_observation": [
    "read logs and health state",
    "review generated intelligence",
    "capture evidence"
  ],
  "allowed_intervention": [
    "documented process restart",
    "externally forced credential rotation",
    "documented response to provider outage"
  ],
  "invalidating_intervention": [
    "manual ordinary ingestion",
    "checkpoint editing",
    "manual output deduplication or fan-out repair",
    "threshold changes",
    "unlogged product-code change"
  ],
  "restart_rule": "Any acceptance-critical product-code change restarts the full seven-calendar-day and five-business-day window from the corrected commit."
}
